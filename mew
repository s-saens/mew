#!/usr/bin/env bash
# mew — install and run this editor on your own machine.
#   ./mew setup    first time (safe to re-run)
#   ./mew help     everything else
#
# Nothing is stored in this folder: settings go to ~/.config/mew/config.env,
# accounts to ~/.local/share/mew, logs to ~/.local/state/mew. Delete the clone, keep your data.
set -euo pipefail

cd "$(dirname "$0")"
APP=$(pwd)

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/mew"
CONFIG="$CONFIG_DIR/config.env"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/mew"
PIDFILE="$STATE_DIR/mew.pid"
LOG="$STATE_DIR/mew.log"

say() { printf '%s\n' "$*"; }
die() { printf 'error: %s\n' "$*" >&2; exit 1; }

# `read -p` writes the prompt to stderr, so callers can capture the answer.
ask() {
  local answer=''
  if [ -t 0 ]; then read -r -p "$1 [$2]: " answer </dev/tty || true; fi
  printf '%s' "${answer:-$2}"
}

yes_no() { [ "$(ask "$1 (y/n)" "$2")" = y ]; }

port_in_use() {
  (exec 3<>"/dev/tcp/127.0.0.1/$1") 2>/dev/null || return 1
  exec 3<&-
  return 0
}

pick_port() {
  local port=$1 tries=0
  while port_in_use "$port" && [ "$tries" -lt 20 ]; do
    port=$((port + 1)); tries=$((tries + 1))
  done
  printf '%s' "$port"
}

set_config() {
  local key=$1 value=$2 tmp
  mkdir -p "$CONFIG_DIR"; chmod 700 "$CONFIG_DIR"
  touch "$CONFIG"; chmod 600 "$CONFIG"
  if grep -q "^${key}=" "$CONFIG"; then
    tmp="${CONFIG}.tmp.$$"
    awk -v key="$key" -v value="$value" '
      BEGIN { prefix = key "=" }
      index($0, prefix) == 1 { $0 = prefix value }
      { print }
    ' "$CONFIG" >"$tmp"
    mv "$tmp" "$CONFIG"
    chmod 600 "$CONFIG"
  else
    printf '%s=%s\n' "$key" "$value" >>"$CONFIG"
  fi
}

load_config() {
  [ -f "$CONFIG" ] || return 0
  set -a
  # shellcheck disable=SC1090
  . "$CONFIG"
  set +a
}

url() {
  local host=localhost
  if is_termux; then
    host="${MEW_BIND:-127.0.0.1}"
    case "$host" in
      0.0.0.0) host=127.0.0.1 ;;
      ::) host='[::1]' ;;
      *:*) host="[$host]" ;;
    esac
  fi
  printf 'http://%s:%s' "$host" "${MEW_TEAM_PORT:-5000}"
}

# ── requirements ────────────────────────────────────────────────────────────

is_termux() {
  case "${PREFIX:-}" in
    /data/data/*/files/usr|/data/user/*/*/files/usr) [ "$(uname -o 2>/dev/null)" = Android ] && command -v pkg >/dev/null 2>&1 ;;
    *) return 1 ;;
  esac
}

interactive() { [ -t 0 ]; }
unattended=false

# Node runs the server's TypeScript directly, which needs type stripping on by default (22.18+).
node_version_ok() {
  local v major minor
  v=$(node -p 'process.versions.node' 2>/dev/null) || return 1
  major=${v%%.*}; minor=${v#*.}; minor=${minor%%.*}
  [ "$major" -ge 24 ] && return 0
  [ "$major" -eq 22 ] && [ "$minor" -ge 18 ]
}

need_node() {
  node_version_ok && return 0
  say "Node 22.18+ (or 24+) is required; found: $(node -v 2>/dev/null || echo 'none')"
  if is_termux; then
    if $unattended || { interactive && yes_no "Install Termux Node.js LTS and npm with pkg?" y; }; then
      pkg install -y nodejs-lts npm
      export PATH="$PREFIX/bin:$PATH"
      hash -r
      node_version_ok || die "Termux Node still cannot run or is too old; update Termux packages and retry"
    else
      die "install Node with: pkg install nodejs-lts npm"
    fi
    return
  fi
  if [ -t 0 ] && yes_no "Install it with nvm? (no sudo, installs into your home)" y; then
    curl -fsSL https://raw.githubusercontent.com/nvm-sh/nvm/v0.40.1/install.sh | bash
    export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
    [ -s "$NVM_DIR/nvm.sh" ] || die "nvm did not install into $NVM_DIR — install Node 24 yourself and re-run"
    # shellcheck disable=SC1091
    . "$NVM_DIR/nvm.sh"
    nvm install 24
    node_version_ok || die "still on $(node -v) — open a new terminal and run ./mew setup again"
  else
    die "install Node 24 (https://nodejs.org) and run ./mew setup again"
  fi
}

# The terminal panel is built from source (node-pty has no prebuilt), so npm needs a compiler.
# Without this, `npm ci` dies in node-gyp with pages of unrelated-looking errors.
need_build_tools() {
  local missing=()
  local os; os=$(uname -s 2>/dev/null || echo unknown)

  if is_termux; then
    command -v cc >/dev/null 2>&1 || missing+=(clang)
    command -v make >/dev/null 2>&1 || missing+=(make)
    command -v python3 >/dev/null 2>&1 || missing+=(python)
    command -v tmux >/dev/null 2>&1 || missing+=(tmux)
  elif [ "$os" = Darwin ]; then
    xcode-select -p >/dev/null 2>&1 || missing+=("xcode-command-line-tools")
    command -v cc >/dev/null 2>&1 || missing+=("xcode-command-line-tools")
    command -v make >/dev/null 2>&1 || missing+=("xcode-command-line-tools")
    command -v python3 >/dev/null 2>&1 || missing+=(python3)
    command -v tmux >/dev/null 2>&1 || missing+=(tmux)
  else
    command -v cc >/dev/null 2>&1 || command -v gcc >/dev/null 2>&1 || missing+=(build-essential)
    command -v make >/dev/null 2>&1 || missing+=(build-essential)
    command -v python3 >/dev/null 2>&1 || missing+=(python3)
    command -v tmux >/dev/null 2>&1 || missing+=(tmux)
  fi
  [ ${#missing[@]} -eq 0 ] && return 0

  local pkgs; pkgs=$(printf '%s\n' "${missing[@]}" | sort -u | tr '\n' ' ')
  say "Missing system packages: $pkgs"
  say "  compiler/python3 — needed to build the terminal (node-pty)"
  say "  tmux             — the terminal panel itself"
  if is_termux; then
    if $unattended || { interactive && yes_no "Install missing Termux packages with pkg?" y; }; then
      pkg install -y "${missing[@]}"
    else
      die "install them with: pkg install $pkgs"
    fi
  elif [ "$os" = Darwin ]; then
    local brew_missing=()
    say ""
    say "On macOS:"
    printf '%s\n' "${missing[@]}" | grep -qx "xcode-command-line-tools" && say "  xcode-select --install"
    printf '%s\n' "${missing[@]}" | grep -qx "tmux" && brew_missing+=(tmux)
    printf '%s\n' "${missing[@]}" | grep -qx "python3" && brew_missing+=(python)
    [ ${#brew_missing[@]} -gt 0 ] && say "  brew install ${brew_missing[*]}"
    if printf '%s\n' "${missing[@]}" | grep -qx "xcode-command-line-tools"; then
      die "install Xcode Command Line Tools, then run ./mew setup again"
    elif command -v brew >/dev/null 2>&1 && [ -t 0 ] && yes_no "Install missing Homebrew packages now?" y; then
      brew install "${brew_missing[@]}"
    else
      die "install the missing tools, then run ./mew setup again"
    fi
  elif command -v apt-get >/dev/null 2>&1 && [ -t 0 ] && yes_no "Install them with apt? (asks for your sudo password)" y; then
    # shellcheck disable=SC2086
    sudo apt-get update && sudo apt-get install -y $pkgs
  else
    die "install them yourself, then run ./mew setup again (Debian/Ubuntu: sudo apt install $pkgs)"
  fi
}

# ── process ─────────────────────────────────────────────────────────────────

running_pid() {
  [ -f "$PIDFILE" ] || return 1
  local pid; pid=$(cat "$PIDFILE")
  kill -0 "$pid" 2>/dev/null || return 1
  printf '%s' "$pid"
}

wait_for_termux_http() {
  if ! "${MEW_NODE:-node}" "$APP/tools/termux-ready.mjs" "$(url)" "$1"; then
    die "Mew did not answer on $(url). Check $LOG before opening the setup link."
  fi
}

start_server() {
  local pid
  if pid=$(running_pid); then
    if is_termux; then wait_for_termux_http "$pid"; fi
    say "already running (pid $pid) — $(url)"
    return 0
  fi
  [ -f dist/index.html ] || die "not built yet — run: ./mew setup"
  prepare_source_browsers check || die "browser dependencies are incomplete — run: npm run browsers:install"
  if is_termux && [ -z "${DATABASE_URL:-}" ]; then
    # shellcheck source=tools/termux-postgres.sh
    . "$APP/tools/termux-postgres.sh"
    start_termux_postgres
  fi
  mkdir -p "$STATE_DIR"
  nohup "${MEW_NODE:-node}" server/serve.ts >>"$LOG" 2>&1 &
  echo $! >"$PIDFILE"
  disown || true
  if is_termux; then
    wait_for_termux_http "$(cat "$PIDFILE")"
    return
  fi
  sleep 1
  running_pid >/dev/null || { tail -n 20 "$LOG" >&2; die "failed to start — see $LOG"; }
}

stop_server() {
  local pid
  if pid=$(running_pid); then
    kill "$pid"
    for _ in $(seq 1 20); do running_pid >/dev/null || break; sleep 0.2; done
    running_pid >/dev/null && kill -9 "$pid" 2>/dev/null || true
    rm -f "$PIDFILE"
    say "stopped"
  else
    say "not running"
  fi
  if is_termux && [ -z "${DATABASE_URL:-}" ]; then
    # shellcheck source=tools/termux-postgres.sh
    . "$APP/tools/termux-postgres.sh"
    stop_termux_postgres
  fi
}

create_first_owner() {
  FIRST_OWNER_SETUP_URL=''
  local setup token
  setup=$(node server/usersCli.ts setup --json) || die "could not prepare administrator setup; check the account data before retrying"
  token=$(printf '%s' "$setup" | node -e '
    let input = "";
    process.stdin.on("data", value => input += value);
    process.stdin.on("end", () => {
      try {
        const setup = JSON.parse(input);
        if (setup.setupRequired === false) return;
        if (setup.setupRequired !== true || typeof setup.token !== "string" || !/^[A-Za-z0-9_-]{43}$/.test(setup.token)) process.exit(1);
        process.stdout.write(setup.token);
      } catch { process.exit(1); }
    });
  ') || die "invalid administrator setup response"
  if [ -n "$token" ]; then FIRST_OWNER_SETUP_URL="$(url)/#setup=$token"; fi
}

print_first_owner_link() {
  if [ -n "${FIRST_OWNER_SETUP_URL:-}" ]; then
    say "Create your administrator account in your browser using this private setup link:"
    say "$FIRST_OWNER_SETUP_URL"
    if is_termux && command -v termux-open-url >/dev/null 2>&1; then
      termux-open-url "$FIRST_OWNER_SETUP_URL" || true
    fi
  else
    say "Next: open $(url) and sign in with your existing account."
  fi
}

cmd_setup_link() {
  is_termux || die "setup-link is available on native Termux"
  load_config
  local pid
  pid=$(running_pid) || die "Mew is not running. Start it with: bash $APP/mew start"
  wait_for_termux_http "$pid"
  create_first_owner
  print_first_owner_link
}

# ── commands ────────────────────────────────────────────────────────────────

remote_access_guide() {
  local method=${1:-}
  if [ -z "$method" ]; then method=$(ask 'Remote access: account / cloudflare / tailscale / none' none); fi
  case "$method" in
    account)
      say "Open $(url), sign in as the local owner, and change any temporary password first."
      say "Menu > Account management > Remote access > Register device opens a one-time account login URL."
      say "Finish login and choose a device name; the fixed address appears in Account management and the central dashboard."
      say "The central service and a configured login provider must be available."
      ;;
    cloudflare) say "Use your existing Cloudflare Tunnel setup. See docs/deployment/native.md (HTTPS and proxy headers)." ;;
    tailscale) say "Use your existing Tailscale network. See docs/deployment/native.md (binding and HTTPS)." ;;
    none) say "Keep local access. Remove an existing account registration from Menu > Account management > Remote access." ;;
    *) die "choose account, cloudflare, tailscale, or none" ;;
  esac
}

cmd_setup() {
  if [ "${1:-}" = --termux-defaults ]; then
    is_termux || die "Termux defaults require native Termux"
    unattended=true
  fi
  need_node
  need_build_tools

  if [ -f "$CONFIG" ]; then
    say "using existing settings: $CONFIG"
  else
    local ws port
    ws="$HOME/mew-workspace"
    if ! $unattended; then ws=$(ask "Folder to edit — each subfolder in it becomes a project" "$ws"); fi
    ws=${ws/#\~/$HOME}
    mkdir -p "$ws"; ws=$(cd "$ws" && pwd)
    if [ -z "$(ls -A "$ws")" ]; then
      mkdir -p "$ws/docs"
      printf '# Welcome to mew\n\nEvery top-level folder in this workspace is a project.\nThis file is `docs/README.md`.\n' >"$ws/docs/README.md"
      say "workspace was empty — created $ws/docs to start with"
    fi
    port=5000
    if ! $unattended; then port=$(ask 'Port' "$port"); fi
    port=$(pick_port "$port")
    set_config MEW_WORKSPACE "$ws"
    set_config MEW_TEAM_PORT "$port"

    if ! $unattended && [ -t 0 ] && yes_no "Connect a Postgres for the /db table view? (you can do it later)" n; then
      set_config DATABASE_URL "$(ask 'DATABASE_URL' 'postgres://mew:mew@127.0.0.1:5432/mew')"
    fi
    say "settings written to $CONFIG"
  fi
  load_config
  if is_termux && [ -z "${DATABASE_URL:-}" ]; then
    command -v pg_ctl >/dev/null 2>&1 || pkg install -y postgresql
  fi

  say "installing dependencies..."
  npm ci --no-audit --no-fund
  prepare_source_browsers install
  say "building..."
  npm run build
  create_first_owner
  start_server
  say ""
  say "mew is running: $(url)"
  say ""
  print_first_owner_link
  if ! $unattended && [ -t 0 ]; then remote_access_guide; fi
}

prepare_source_browsers() {
  if is_termux; then return 0; fi
  npm run "browsers:$1"
}

cmd_update() {
  load_config
  git pull --ff-only origin main || die "git pull failed — commit or stash your local changes first"
  say "installing dependencies..."
  npm ci --no-audit --no-fund || die "dependency installation failed — update failed"
  prepare_source_browsers install || die "browser dependency installation failed — update failed; server was not restarted"
  say "building..."
  npm run build || die "build failed — update failed; server was not restarted"
  say "restarting..."
  stop_server || die "server stop failed — update failed"
  start_server || die "server restart failed — update failed"
  say "updated. $(url)"
}

cmd_status() {
  load_config
  local pid
  if pid=$(running_pid); then say "running (pid $pid)"; else say "stopped"; fi
  say "url:       $(url)"
  say "workspace: ${MEW_WORKSPACE:-$(dirname "$APP") (default)}"
  say "settings:  $CONFIG"
  # mirrors server/config.ts: an existing .data/ from an older install keeps winning
  local data=${MEW_DATA_DIR:-}
  if [ -z "$data" ]; then
    if [ -d "$APP/.data" ]; then data="$APP/.data"; else data="${XDG_DATA_HOME:-$HOME/.local/share}/mew"; fi
  fi
  say "accounts:  $data"
  say "log:       $LOG"
}

usage() {
  cat <<'EOF'
mew — a browser workspace for a folder on your machine

  ./mew setup           install, configure and start (safe to re-run)
  ./mew setup-link      reopen first-owner setup on a running Termux instance
  ./mew remote-access [account|cloudflare|tailscale|none]   show owner registration or existing network setup instructions
  ./mew start | stop    start / stop the server
  ./mew restart         restart it
  ./mew update          fast-forward origin/main, rebuild, restart
  ./mew status          what is running, and where things live
  ./mew logs            follow the log (ctrl-c to stop)
  ./mew users <args>    accounts: setup | add <email> [owner|manager|member] | list | role | reset | remove
EOF
}

case "${1:-setup}" in
  setup) cmd_setup "${2:-}" ;;
  setup-link) cmd_setup_link ;;
  remote-access) load_config; remote_access_guide "${2:-account}" ;;
  update) cmd_update ;;
  status) cmd_status ;;
  start) load_config; start_server; say "$(url)" ;;
  stop) if is_termux; then load_config; fi; stop_server ;;
  restart) load_config; prepare_source_browsers check || die "browser dependencies are incomplete — run: npm run browsers:install"; stop_server; start_server; say "$(url)" ;;
  logs) mkdir -p "$STATE_DIR"; touch "$LOG"; tail -f -n 100 "$LOG" ;;
  users) shift; load_config; node server/usersCli.ts "$@" ;;
  help | -h | --help) usage ;;
  *) usage; exit 1 ;;
esac
